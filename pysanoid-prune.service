[Unit]
Description=Cleanup ZFS Pool
Requires=zfs.target
After=zfs.target pysanoid.service
ConditionFileNotEmpty=/etc/pysanoid/sanoid.conf
OnFailure=pysanoid-alert@%n.service

[Service]
Environment=TZ=UTC
Type=oneshot
TimeoutStartSec=30min
ExecStart=/usr/local/sbin/pysanoid.py --prune-snapshots --verbose

[Install]
WantedBy=pysanoid.service
