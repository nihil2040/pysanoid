#!/usr/bin/env python3
"""Fake hook script for run_hook_script/runscript differential testing (dev/diff_hooks.py,
dev/diff_prune.py, dev/diff_take_snapshots.py). Both sides run it the way upstream and pysanoid run
a real pre/post/pruning script: as a command line, handed to system($config{$dataset}{$key}) /
run_hook_script, so each side decides how it is split and whether a shell runs it. Logs one JSON
line to $HOOK_LOG per invocation -- its tag, every argument it was given, and the SANOID_* env
vars it can see -- then optionally sleeps, then exits with the requested code. A diff_*.py compares
the two sides' log files the same way dev/fake_zfs/zfs's $FAKE_ZFS_LOG is compared.

    hook_probe TAG EXIT_CODE [SLEEP_SECONDS] [ANYTHING ...]

TAG identifies which call site this stands in for (e.g. "pre", "post", "prune"), so a scenario
with more than one hook configured can tell the invocations apart in the log. SLEEP_SECONDS (a
number; anything else is just another argument) lets a scenario outlast a short script_timeout;
logging happens BEFORE the sleep so a killed run still leaves its record. Further words (a
trailing `# comment` that no shell stripped, say) are only logged.
"""
import json
import os
import sys

tag = sys.argv[1]
exit_code = int(sys.argv[2])
try:
    sleep_s = float(sys.argv[3]) if len(sys.argv) > 3 else 0.0
except ValueError:
    sleep_s = 0.0

ENV_KEYS = ("SANOID_TARGET", "SANOID_TARGETS", "SANOID_SNAPNAME", "SANOID_SNAPNAMES",
            "SANOID_TYPES", "SANOID_SCRIPT", "SANOID_PRE_FAILURE")

entry = {"tag": tag, "argv": sys.argv[1:], "env": {k: os.environ[k] for k in ENV_KEYS if k in os.environ}}

with open(os.environ["HOOK_LOG"], "a") as f:
    f.write(json.dumps(entry) + "\n")

if sleep_s:
    import time
    time.sleep(sleep_s)
sys.exit(exit_code)
