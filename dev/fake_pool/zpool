#!/usr/bin/env python3
"""Fake `zpool list -H -o cap <pool>` for dev/diff_whole_run.py: the pool's capacity from $FAKE_POOL's "cap"."""
import fcntl
import json
import os
import sys

_lock = open(os.environ["FAKE_POOL"] + ".lock", "a")  # noqa: SIM115 - held until the process ends
fcntl.flock(_lock, fcntl.LOCK_EX)
with open(os.environ["FAKE_POOL"]) as fh:
    cap = json.load(fh).get("cap", {}).get(sys.argv[-1])
if cap is None:
    sys.stderr.write(f"cannot open '{sys.argv[-1]}': no such pool\n")
    sys.exit(1)
print(cap)
